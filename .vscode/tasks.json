{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "SLR: Install locked core",
      "type": "process",
      "command": "uv",
      "args": [
        "sync",
        "--locked"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Select OpenCode configuration",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/select_opencode_config.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Initialize",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "init"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Approve protocol (human)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "approve-protocol",
        "--reviewer",
        "${input:reviewer}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Review proposal (human)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "review",
        "${input:proposalId}",
        "--reviewer",
        "${input:reviewer}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Status",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "status"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Export report",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "report"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Audit",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "slr_workbench",
        "audit"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Validate project",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "scripts/validate_project.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: Tests",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "SLR: OpenCode",
      "type": "process",
      "command": "uv",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": [],
      "args": [
        "run",
        "--no-sync",
        "opencode"
      ]
    }
  ],
  "inputs": [
    {
      "id": "reviewer",
      "type": "promptString",
      "description": "Configured human reviewer identity"
    },
    {
      "id": "proposalId",
      "type": "promptString",
      "description": "Proposal ID returned by slr submit"
    }
  ]
}
