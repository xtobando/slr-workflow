{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "slr",
  "share": "disabled",
  "agent": {
    "slr": {
      "description": "Evidence-grounded SLR coordinator",
      "mode": "primary",
      "prompt": "Coordinate the systematic review using project-local slr skills. Read AGENTS.md, protocol.yaml and workflow.yaml. Submit evidence-backed drafts through the Python CLI. Hand all human decision commands to the user. Inherit the currently selected provider/model."
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": {
      "slr-*": "allow"
    },
    "edit": {
      "*": "ask",
      "data/drafts/*": "allow",
      "data/synthesis/*": "allow",
      "data/*.sqlite*": "deny"
    },
    "bash": {
      "*": "ask",
      "slr init*": "allow",
      "python -m slr_workbench init*": "allow",
      "slr workflow*": "allow",
      "python -m slr_workbench workflow*": "allow",
      "slr records*": "allow",
      "python -m slr_workbench records*": "allow",
      "slr status*": "allow",
      "python -m slr_workbench status*": "allow",
      "slr packet*": "allow",
      "python -m slr_workbench packet*": "allow",
      "slr proposal*": "allow",
      "python -m slr_workbench proposal*": "allow",
      "slr submit*": "allow",
      "python -m slr_workbench submit*": "allow",
      "slr deduplicate*": "allow",
      "python -m slr_workbench deduplicate*": "allow",
      "slr attach*": "allow",
      "python -m slr_workbench attach*": "allow",
      "slr report*": "allow",
      "python -m slr_workbench report*": "allow",
      "slr audit*": "allow",
      "python -m slr_workbench audit*": "allow",
      "slr search-corpus*": "allow",
      "python -m slr_workbench search-corpus*": "allow",
      "slr schema*": "allow",
      "python -m slr_workbench schema*": "allow",
      "slr approve-protocol*": "deny",
      "slr review*": "deny",
      "slr retrieval*": "deny",
      "slr link-study*": "deny",
      "python* -m slr_workbench*approve-protocol*": "deny",
      "python* -m slr_workbench*review*": "deny",
      "python* -m slr_workbench*retrieval*": "deny",
      "python* -m slr_workbench*link-study*": "deny",
      "slr unlink-study*": "deny",
      "python* -m slr_workbench*unlink-study*": "deny"
    }
  }
}
