{
  "$defs": {
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "title",
            "abstract",
            "document"
          ],
          "title": "Source",
          "type": "string"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "element_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Element Id"
        }
      },
      "required": [
        "source",
        "quote"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "ExtractedValue": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "observed",
            "not_reported",
            "not_applicable",
            "unclear"
          ],
          "title": "Status",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "title": "ExtractedValue",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "wrapper": {
          "default": "opencode",
          "title": "Wrapper",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Sha256"
        },
        "notes": {
          "default": "",
          "title": "Notes",
          "type": "string"
        }
      },
      "title": "Provenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_revision": {
      "title": "Protocol Revision",
      "type": "string"
    },
    "entity_type": {
      "enum": [
        "review",
        "record",
        "report",
        "study"
      ],
      "title": "Entity Type",
      "type": "string"
    },
    "entity_id": {
      "title": "Entity Id",
      "type": "string"
    },
    "stage": {
      "title": "Stage",
      "type": "string"
    },
    "suggestion": {
      "title": "Suggestion",
      "type": "string"
    },
    "rationale": {
      "minLength": 1,
      "title": "Rationale",
      "type": "string"
    },
    "criteria": {
      "items": {
        "type": "string"
      },
      "title": "Criteria",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    },
    "values": {
      "additionalProperties": {
        "$ref": "#/$defs/ExtractedValue"
      },
      "title": "Values",
      "type": "object"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    }
  },
  "required": [
    "protocol_revision",
    "entity_type",
    "entity_id",
    "stage",
    "suggestion",
    "rationale"
  ],
  "title": "Draft",
  "type": "object"
}